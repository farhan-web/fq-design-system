{
  "name": "fq-design-system",
  "version": "0.1.0",
  "description": "A lightweight, accessible React design system built with CSS custom properties",
  "keywords": [
    "react",
    "design-system",
    "components",
    "ui",
    "typescript",
    "css",
    "accessible",
    "a11y"
  ],
  "author": "HAEID",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HAEID/fq-design-system.git"
  },
  "homepage": "https://github.com/HAEID/fq-design-system#readme",
  "bugs": {
    "url": "https://github.com/HAEID/fq-design-system/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "changeset": "changeset",
    "release": "npm run build && changeset publish"
  },
  "sideEffects": ["**/*.css"],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^6.4.0",
    "lucide-react": "^1.30.0",
    "@changesets/cli": "^2.29.5",
    "@chromatic-com/storybook": "latest",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-onboarding": "^10.5.7",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-storybook": "^10.5.7",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "playwright": "latest",
    "prettier": "^3.5.3",
    "storybook": "^10.5.7",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "latest"
  },
  "main": "./dist/fq-design-system.js",
  "module": "./dist/fq-design-system.js",
  "types": "./dist/fq-design-system.d.ts",
  "exports": {
    ".": {
      "types": "./dist/fq-design-system.d.ts",
      "import": "./dist/fq-design-system.js",
      "default": "./dist/fq-design-system.js"
    },
    "./style.css": "./dist/fq-design-system.css"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@mui/material": ">=5.0.0",
    "@emotion/react": ">=11.0.0",
    "@emotion/styled": ">=11.0.0",
    "lucide-react": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@mui/material": {
      "optional": true
    },
    "@emotion/react": {
      "optional": true
    },
    "@emotion/styled": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    }
  }
}
